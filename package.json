{
  "name": "pipelineiq",
  "version": "0.2.2",
  "description": "AI-powered CI/CD failure intelligence for GitHub, Azure DevOps & Jira",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "packages/core/dist",
    "packages/cli/dist",
    "packages/github-action/dist",
    "packages/azure-devops-extension/dist"
  ],
  "keywords": [
    "ci-cd",
    "devops",
    "jira",
    "github-actions",
    "azure-devops",
    "ai",
    "failure-detection",
    "automation"
  ],
  "author": "PipelineIQ Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/meetpatel1111/PipelineIQ.git"
  },
  "bugs": {
    "url": "https://github.com/meetpatel1111/PipelineIQ/issues"
  },
  "homepage": "https://github.com/meetpatel1111/PipelineIQ#readme",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^20.19.41",
    "tsup": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^1.5.0"
  }
}
