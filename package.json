{
  "name": "pipelineiq",
  "version": "0.21.0",
  "description": "AI-powered CI/CD failure intelligence for GitHub, Azure DevOps & Jira",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "pipelineiq": "./bin/pipelineiq"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run sync-version && npm run build:core && npm run build:cli && npm run build:platforms",
    "sync-version": "node scripts/sync-version.js",
    "version": "npm run sync-version && git add task.json action.yml",
    "build:core": "tsup src/core/index.ts --format esm --dts --outDir dist",
    "build:cli": "tsup src/cli/index.ts --format esm --dts --outDir dist/cli",
    "build:platforms": "npm run build:github-action && npm run build:azure-devops",
    "build:github-action": "tsup src/github-action/index.ts --format esm --no-dts --outDir dist/github-action",
    "build:azure-devops": "tsup src/azure-devops/index.ts --format cjs --no-dts --outDir dist/azure-devops",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules"
  },
  "files": [
    "dist",
    "bin",
    "action.yml",
    "task.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ci-cd",
    "devops",
    "jira",
    "github-actions",
    "azure-devops",
    "ai",
    "failure-detection",
    "automation"
  ],
  "author": "Meetkumar Patel <pmeet464@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/meetpatel1111/PipelineIQ.git"
  },
  "bugs": {
    "url": "https://github.com/meetpatel1111/PipelineIQ/issues"
  },
  "homepage": "https://github.com/meetpatel1111/PipelineIQ#readme",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.20.0",
    "@google/generative-ai": "^0.24.1",
    "@octokit/rest": "^20.0.0",
    "axios": "^1.6.0",
    "azure-devops-node-api": "^13.0.0",
    "azure-pipelines-task-lib": "^4.10.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.0",
    "jira-client": "^8.2.2",
    "jira.js": "^3.0.0",
    "openai": "^4.38.0",
    "ora": "^8.0.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/jira-client": "^7.1.9",
    "@types/node": "^20.19.41",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.2",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
